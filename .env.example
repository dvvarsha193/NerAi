# ==============================================================================
# NER-LOGIX INTELLIGENT LOGISTICS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 1. MONGODB ATLAS (Mongoose Database Connection)
# ------------------------------------------------------------------------------
# Get your free MongoDB Atlas cluster connection string from:
# https://www.mongodb.com/cloud/atlas
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nerlogix?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Cloud Database & Auth)
# ------------------------------------------------------------------------------
# Get your Project URL and Anon Public Key from Supabase Dashboard:
# Project Settings -> API
# Example format:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Logistics Copilot Live Inference)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=
